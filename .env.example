VIRA_PROVIDER=extractive
# Optional local model: VIRA_PROVIDER=ollama and VIRA_MODEL=<installed model name>
VIRA_MODEL=
VIRA_OLLAMA_URL=http://127.0.0.1:11434
# Optional local hybrid search model; install it in Ollama before building the index.
VIRA_EMBED_MODEL=nomic-embed-text
VIRA_DB_PATH=./data/vira.db
VIRA_HOST=127.0.0.1
VIRA_PORT=8000
# Optional HTTPS access for a small shared workspace. Keep VIRA_HOST=127.0.0.1
# and forward the public URL through an HTTPS tunnel to localhost:8000.
# Anyone with the public URL can read, add, or delete all shared data when
# VIRA_PUBLIC_ANONYMOUS=1. Use VIRA_ACCOUNTS instead to require a password.
# VIRA_PUBLIC_ORIGIN=https://vira.example.com
# VIRA_PUBLIC_ANONYMOUS=1
# Password-protected alternative (use a random password of at least 16 characters):
# VIRA_ACCOUNTS='{"vira":"replace-with-a-long-random-password"}'
